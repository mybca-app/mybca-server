          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NewsApiResponseOfNewsStory"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsApiResponseOfNewsStory"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsApiResponseOfNewsStory"
                }
              }
            }
