{
  "openapi": "3.0.1",
  "info": {
    "title": "MyBCA.Server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://main-service-prod-oc1.mybca.link/"
    }
  ],
  "paths": {
    "/api/Bus/List": {
      "get": {
        "tags": [
          "Bus"
        ],
        "summary": "Retrieves a map of each bus to its position",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BusApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Bus/{bus}/History": {
      "get": {
        "tags": [
          "Bus"
        ],
        "summary": "Retrieves a history of a bus's arrivals",
        "parameters": [
          {
            "name": "bus",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BusArrival"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BusArrival"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BusArrival"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Links": {
      "get": {
        "tags": [
          "Link"
        ],
        "summary": "Retrieves a list of quick links to key BCA services",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LinkApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkApiResponse"
                }
              }
            }
          }
        }
      }
    },
