  "components": {
    "schemas": {
      "BusApiResponse": {
        "required": [
          "count",
          "data",
          "expiry"
        ],
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "BusArrival": {
        "required": [
          "busName",
          "busPosition"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "busName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "busPosition": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "arrivalTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FoodItem": {
        "required": [
          "id",
          "name",
          "description",
          "subtext",
          "imageUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "subtext": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Link": {
        "required": [
          "name",
          "target"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "LinkApiResponse": {
        "required": [
          "count",
          "data"
        ],
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "MenuDay": {
        "required": [
          "date",
          "menuItems"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "nullable": true
          },
          "menuItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "MenuDay2": {
        "required": [
          "date",
          "menuItems"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "nullable": true
          },
          "menuItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        },
        "nullable": true
      },
      "MenuItem": {
        "required": [
          "date",
          "position",
          "isSectionTitle",
          "text",
          "food",
          "stationID",
          "isStationHeader",
          "image",
          "category"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "isSectionTitle": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "food": {
            "$ref": "#/components/schemas/FoodItem"
          },
          "stationID": {
            "type": "integer",
            "format": "uint32"
          },
          "isStationHeader": {
            "type": "boolean"
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "MenuWeek": {
        "required": [
          "startDate",
          "displayName",
          "days"
        ],
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuDay"
            }
          }
        },
        "nullable": true
      },
      "NewsApiResponseOfNewsStory": {
        "required": [
          "data",
          "expiry"
        ],
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/NewsStory"
          },
          "expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "NewsStory": {
        "required": [
          "title",
          "link",
          "imageLink",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "imageLink": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "nullable": true
      },
      "NutrisliceApiResponseOfMenuDay": {
        "required": [
          "data",
          "expiry"
        ],
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MenuDay2"
          },
          "expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "NutrisliceApiResponseOfMenuWeek": {
        "required": [
          "data",
          "expiry"
        ],
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MenuWeek"
          },
          "expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Schedule": {
        "required": [
          "name",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleItem"
            }
          }
        },
        "nullable": true
      },
      "ScheduleDay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "scheduleId": {
            "type": "integer",
            "format": "int32"
          },
          "schedule": {
            "$ref": "#/components/schemas/Schedule"
          }
        }
      },
      "ScheduleItem": {
        "required": [
          "periodName"
        ],
        "type": "object",
        "properties": {
          "periodName": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
            "format": "time"
          }
        }
      }
    }
